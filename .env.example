# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Gemini API key (Google AI Studio). Required — the Desk fails fast at
# startup with a one-line message if this is missing (constitution.md §2).
GEMINI_API_KEY=

# Tracing export key for the OpenAI Agents SDK traces dashboard (FR-13).
# Optional for local dev; required to satisfy FR-13's "exported under your
# own key" done-condition.
OPENAI_API_KEY=
