# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# OpenAI API key. Required -- the Desk fails fast at startup with a
# one-line message if this is missing (constitution.md §2). Used both
# for the model (gpt-4o-mini, configured in desk/config.py) and for
# exporting traces under your own key (FR-13).
OPENAI_API_KEY=
